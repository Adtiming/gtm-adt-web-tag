___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const copyFromDataLayer = require('copyFromDataLayer');
const createQueue = require('createQueue');
const getType = require('getType');
const injectScript = require('injectScript');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const setInWindow = require('setInWindow');

function asId(value) {
  const type = getType(value);
  return type === 'string' || type === 'number' ? makeString(value).trim() : '';
}

function asAmount(value) {
  if (!asId(value)) return undefined;
  const amount = makeNumber(value);
  return amount >= 0 && amount - amount === 0 ? amount : undefined;
}

const mode = data.mode || 'event';

if (mode === 'setup') {
  const partnerId = asAmount(data.partnerId);
  if (!(partnerId >= 1 && partnerId <= 4294967295 && partnerId % 1 === 0)) {
    return data.gtmOnFailure();
  }

  const configured = setInWindow('adtWebTag', {
    config: { partnerId: partnerId, autoStart: true }
  }, false);

  if (!configured) return data.gtmOnFailure();

  injectScript(
    'https://img.adtiming.com/rtb/adt-web-tag.v1.min.js',
    data.gtmOnSuccess,
    data.gtmOnFailure,
    'adt-web-tag-v1'
  );
  return;
}

if (mode !== 'event') return data.gtmOnFailure();

const eventCodes = {
  view_item: 4,
  add_to_cart: 5,
  view_cart: 6,
  begin_checkout: 7,
  purchase: 8,
  login: 13,
  sign_up: 14,
  kyc: 15,
  deposit: 16,
  remove_from_cart: 17
};

const eventType = data.eventType;
const eventCode = eventCodes[eventType];
if (getType(eventCode) !== 'number' || copyFromDataLayer('event') !== eventType) {
  return data.gtmOnFailure();
}

if (eventCode >= 13 && eventCode <= 16) {
  const payload = { e: eventCode };
  const cuid = asId(copyFromDataLayer('cuid'));
  if (cuid) payload.cuid = cuid;

  if (eventType === 'login' || eventType === 'sign_up') {
    const method = asId(copyFromDataLayer('method'));
    if (method) payload.data = { method: method };
  }

  const pushEvent = createQueue('adtWebTagQueue');
  pushEvent(payload);
  return data.gtmOnSuccess();
}

const sourceItems = copyFromDataLayer('ecommerce.items');
if (getType(sourceItems) !== 'array') return data.gtmOnFailure();

const items = [];
sourceItems.forEach(function (source) {
  if (getType(source) !== 'object') return;
  const productId = asId(source.item_id);
  if (!productId) return;

  const quantity = asAmount(source.quantity);
  const price = asAmount(source.price);
  const item = {
    pid: productId,
    q: quantity > 0 && quantity <= 9007199254740991 && quantity % 1 === 0 ? quantity : 1
  };
  if (price !== undefined) item.p = price;
  items.push(item);
});
if (!items.length) return data.gtmOnFailure();

const payload = { e: eventCode, items: items };
if (eventType === 'purchase') {
  const transactionId = asId(copyFromDataLayer('ecommerce.transaction_id'));
  const transactionValue = asAmount(copyFromDataLayer('ecommerce.value'));
  if (!transactionId || transactionValue === undefined) return data.gtmOnFailure();
  payload.tranId = transactionId;
  payload.tranValue = transactionValue;
}

const pushEvent = createQueue('adtWebTagQueue');
pushEvent(payload);
data.gtmOnSuccess();


