- name: login with customer ID and method
  code: |-
    const values = {"event": "login", "cuid": 42, "method": "sso"};
    const queued = [];
    mock('copyFromDataLayer', function (key) {
      return values[key];
    });
    mock('createQueue', function () {
      return function (payload) {
        queued.push(payload);
      };
    });

    runCode({mode: 'event', eventType: 'login'});

    assertApi('createQueue').wasCalledWith('adtWebTagQueue');
    assertThat(queued).isEqualTo([{"e": 13, "cuid": "42", "data": {"method": "sso"}}]);
